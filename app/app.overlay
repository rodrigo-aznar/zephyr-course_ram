/ {
    aliases {
        app-led = &my_led;
    };

    leds {
        compatible = "gpio-leds";
        my_led: led_0 {
            /* Use &gpio0, then the pin number (17), then the flag */
            gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
            label = "User LED";
        };

    };

    my_driver0: my_driver {
        compatible = "ram,driver";
        gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
        default-sleep-ms = <200>;
        sleep-ms = <200>;
        status = "okay";
    };
};
